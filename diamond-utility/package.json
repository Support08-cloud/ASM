{
  "name": "diamond-utility",
  "private": true,
  "version": "1.0.0",
  "author": "Vision 360",
  "description": "Local diamond data utility for scanning folders and extracting MP4s.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Support08-cloud/ASM.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "tech.v360.diamond-utility",
    "productName": "DiamondUtility",
    "copyright": "Vision 360",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DiamondUtility.exe"
    },
    "portable": {
      "artifactName": "DiamondUtility.exe"
    }
  }
}
