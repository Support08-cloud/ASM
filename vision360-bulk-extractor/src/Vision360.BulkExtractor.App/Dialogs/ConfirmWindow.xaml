<Window x:Class="Vision360.BulkExtractor.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start copying"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <CheckBox x:Name="OverwriteCheck" Margin="0,16,0,0" Visibility="Collapsed"
                  Content="I understand existing files will be overwritten"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="Start copying" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
