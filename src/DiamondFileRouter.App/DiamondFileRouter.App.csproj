<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <RootNamespace>DiamondFileRouter.App</RootNamespace>
    <AssemblyName>DiamondFileRouter</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>Diamond File Router</ApplicationTitle>
    <Title>Diamond File Router</Title>
    <Description>Vision 360 internal offline utility that routes diamond and stone files into existing destination folders.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiamondFileRouter.Core\DiamondFileRouter.Core.csproj" />
  </ItemGroup>
    <ItemGroup>
        <Resource Include="Assets\logo.png">
            <LogicalName>Assets/logo.png</LogicalName>
        </Resource>
        <Resource Include="Assets\logo-white.png">
            <LogicalName>Assets/logo-white.png</LogicalName>
        </Resource>
        <Resource Include="Assets\app-icon-256.png">
            <LogicalName>Assets/app-icon-256.png</LogicalName>
        </Resource>
        <Resource Include="Assets\app.ico">
            <LogicalName>Assets/app.ico</LogicalName>
        </Resource>
    </ItemGroup>
</Project>
