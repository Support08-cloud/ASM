<Window x:Class="DiamondFileRouter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiamondFileRouter.App.Views"
        Title="Diamond File Router — VISION 360°"
        Height="860" Width="1320"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WhiteBrush}"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource NavyBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,8">
                        <Image Source="pack://application:,,,/Assets/logo-white.png"
                               Height="72" Stretch="Uniform" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Diamond File Router" Foreground="{StaticResource WhiteBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"/>
                        <TextBlock Text="V360.Tech · Internal utility" Foreground="{StaticResource CloudGreyBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,5" Margin="0,14,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="INTERNAL USE ONLY" Foreground="{StaticResource CloudGreyBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                        <TextBlock Text="{Binding VersionText}" Foreground="#B0B0B0" FontSize="11"/>
                        <TextBlock Text="No internet required" Foreground="#B0B0B0" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="12,24,12,0">
                        <RadioButton Content="Router" Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsString}, ConverterParameter=router, Mode=OneWay}"
                                     Command="{Binding ShowRouterCommand}"/>
                        <RadioButton Content="History" Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsString}, ConverterParameter=history, Mode=OneWay}"
                                     Command="{Binding ShowHistoryCommand}"/>
                        <RadioButton Content="Settings" Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsString}, ConverterParameter=settings, Mode=OneWay}"
                                     Command="{Binding ShowSettingsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource WhiteBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Height="32" Background="{StaticResource CharcoalBrush}">
                    <DockPanel Margin="16,0">
                        <TextBlock Text="v360.tech" DockPanel.Dock="Right" Foreground="{StaticResource CloudGreyBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource WhiteBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource WhiteBrush}">
                    <views:RouterView DataContext="{Binding Router}">
                        <views:RouterView.Style>
                            <Style TargetType="views:RouterView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="router">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:RouterView.Style>
                    </views:RouterView>
                    <views:HistoryView DataContext="{Binding History}">
                        <views:HistoryView.Style>
                            <Style TargetType="views:HistoryView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="history">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:HistoryView.Style>
                    </views:HistoryView>
                    <views:SettingsView DataContext="{Binding Settings}">
                        <views:SettingsView.Style>
                            <Style TargetType="views:SettingsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="settings">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:SettingsView.Style>
                    </views:SettingsView>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Height="4" Background="{StaticResource OrangeBrush}"/>
            <Border Height="32" Background="{StaticResource CharcoalBrush}">
                <DockPanel Margin="16,0">
                    <Image DockPanel.Dock="Right" Source="pack://application:,,,/Assets/powered-by-white.png"
                           Height="18" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Studio" Foreground="{StaticResource CloudGreyBrush}" FontSize="12"/>
                        <TextBlock Text="  │  " Foreground="{StaticResource Neutral500Brush}" FontSize="12"/>
                        <TextBlock Text="Tech" Foreground="{StaticResource OrangeBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="  │  " Foreground="{StaticResource Neutral500Brush}" FontSize="12"/>
                        <TextBlock Text="Micro" Foreground="{StaticResource CloudGreyBrush}" FontSize="12"/>
                        <TextBlock Text="  │  " Foreground="{StaticResource Neutral500Brush}" FontSize="12"/>
                        <TextBlock Text="Measure" Foreground="{StaticResource CloudGreyBrush}" FontSize="12"/>
                        <TextBlock Text="  │  " Foreground="{StaticResource Neutral500Brush}" FontSize="12"/>
                        <TextBlock Text="Light" Foreground="{StaticResource CloudGreyBrush}" FontSize="12"/>
                        <TextBlock Text="    V360 Technetronic LLP" Foreground="{StaticResource Neutral500Brush}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
