<Application x:Class="DiamondFileRouter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DiamondFileRouter.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EqualsStringConverter x:Key="EqualsString"/>
            <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
            <converters:InverseBoolConverter x:Key="Not"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
