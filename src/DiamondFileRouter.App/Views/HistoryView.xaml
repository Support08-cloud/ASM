<UserControl x:Class="DiamondFileRouter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"/>
            <StackPanel>
                <TextBlock Text="LOCAL HISTORY" Foreground="{StaticResource CopperBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="Completed sessions stay on this machine" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="0">
            <DataGrid ItemsSource="{Binding Records}" MinHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="WHEN" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    <DataGridTextColumn Header="INPUT" Binding="{Binding InputPath}" Width="2*"/>
                    <DataGridTextColumn Header="OUTPUT" Binding="{Binding OutputPath}" Width="2*"/>
                    <DataGridTextColumn Header="FILES" Binding="{Binding TotalFiles}" Width="80"/>
                    <DataGridTextColumn Header="COPIED" Binding="{Binding Copied}" Width="80"/>
                    <DataGridTextColumn Header="UNMATCHED" Binding="{Binding Unmatched}" Width="100"/>
                    <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="140"/>
                    <DataGridTemplateColumn Header="" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open report" Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
