generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  STAFF
}

enum AdvanceStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

enum OtpPurpose {
  PIN_RESET
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdEmployees Employee[]      @relation("EmployeeCreatedBy")
  advancesIssued   Advance[]       @relation("AdvanceIssuedBy")
  salaryPayouts    SalaryPayout[]  @relation("SalaryPaidBy")
  auditLogs        AuditLog[]
}

model Employee {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  phone            String    @unique
  department       String?
  designation      String?
  monthlySalary    Float     @default(0)
  pinHash          String?
  pinSetAt         DateTime?
  pinFailedAttempts Int      @default(0)
  pinLockedUntil   DateTime?
  isActive         Boolean   @default(true)
  joinedAt         DateTime  @default(now())
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation("EmployeeCreatedBy", fields: [createdById], references: [id])

  advances      Advance[]
  salaryPayouts SalaryPayout[]
  otpTokens     OtpToken[]
  auditLogs     AuditLog[]
}

model Advance {
  id              String         @id @default(cuid())
  receiptNo       String         @unique
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Float
  remainingAmount Float
  issuedAt        DateTime
  note            String?
  status          AdvanceStatus  @default(OPEN)
  issuedById      String
  issuedBy        User           @relation("AdvanceIssuedBy", fields: [issuedById], references: [id])
  createdAt       DateTime       @default(now())

  deductions SalaryDeduction[]

  @@index([employeeId, issuedAt])
  @@index([issuedAt])
}

model SalaryPayout {
  id           String   @id @default(cuid())
  receiptNo    String   @unique
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodLabel  String
  grossSalary  Float
  deducted     Float
  netPaid      Float
  paidAt       DateTime
  note         String?
  paidById     String
  paidBy       User     @relation("SalaryPaidBy", fields: [paidById], references: [id])
  createdAt    DateTime @default(now())

  deductions SalaryDeduction[]

  @@index([employeeId, paidAt])
}

model SalaryDeduction {
  id             String       @id @default(cuid())
  salaryPayoutId String
  salaryPayout   SalaryPayout @relation(fields: [salaryPayoutId], references: [id], onDelete: Cascade)
  advanceId      String
  advance        Advance      @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  amount         Float
  createdAt      DateTime     @default(now())
}

model OtpToken {
  id          String     @id @default(cuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  phone       String
  codeHash    String
  purpose     OtpPurpose @default(PIN_RESET)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([employeeId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  action     String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([employeeId])
}

model Setting {
  id                   String  @id @default("default")
  companyName          String  @default("Vision 360")
  companyTagline       String  @default("Innovating Visions, Crafting Excellence")
  currencySymbol       String  @default("₹")
  demoOtp              Boolean @default(true)
  maxAdvancePercent    Int     @default(100)
  pinMaxAttempts       Int     @default(5)
  pinLockMinutes       Int     @default(15)
  otpExpiryMinutes     Int     @default(5)
  msg91AuthKey         String  @default("")
  msg91TemplateId      String  @default("")
  msg91SenderId        String  @default("V360ASM")
}
